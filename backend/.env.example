# --- Server ---
NODE_ENV=development
PORT=4000

# Origins allowed to call this API (comma separated) — the Next.js app.
CORS_ORIGINS=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://authapp:authapp@localhost:5432/authdb?schema=public

# --- JWT issued by this API and consumed by the Next.js session ---
# Generate with: openssl rand -base64 32
JWT_SECRET=change-me-with-openssl-rand-base64-32
JWT_EXPIRES_IN=7d

# --- Google ---
# Same client id as the frontend. Used as the audience when verifying `id_token`s.
GOOGLE_CLIENT_ID=

# --- Gold price feed (WebSocket namespace /gold-price) ---
GOLD_PRICE_INTERVAL_MS=3000
# Optional. An endpoint returning {"price": 3240000}. Leave empty to simulate prices.
# GOLD_PRICE_API_URL=
