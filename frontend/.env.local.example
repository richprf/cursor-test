# Public URL of this Next.js app (used to build OAuth callback URLs).
NEXTAUTH_URL=http://localhost:3000

# Secret used to encrypt the NextAuth session cookie.
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-with-openssl-rand-base64-32

# Google OAuth client (Web application).
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NestJS API — server-side only, never exposed to the browser.
NEST_API_URL=http://localhost:4000

# BFF proxy (`/api/proxy/*`) — per-user request cap and Nest fetch timeout.
NEST_PROXY_RATE_LIMIT=90
NEST_PROXY_RATE_WINDOW_MS=60000
NEST_PROXY_TIMEOUT_MS=12000

# Same API, but reachable from the browser: used for the live gold price WebSocket
# (namespace /gold-price). Leave empty to fall back to the server-rendered price.
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Higgsfield Cloud — image-to-video (5s clips). Create keys at https://cloud.higgsfield.ai
# HF_API_KEY_ID=
# HF_API_KEY_SECRET=
